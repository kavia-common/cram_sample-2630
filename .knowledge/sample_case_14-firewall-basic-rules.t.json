{"is_source_file": true, "format": "shell script / bash script", "description": "This file is a shell script intended for verifying the presence of basic firewall rulesets on an OpenWrt system. It checks for the existence of nftables chains related to input, forward, and output, and falls back to checking iptables rules if nftables are not available.", "external_files": [], "external_methods": [], "published": [], "classes": [], "methods": [], "calls": ["grep -E 'chain input|chain forward|chain output'", "sed 's/[[:space:]]\\+/ /g'", "sort", "uniq", "iptables -L"], "search-terms": ["firewall ruleset verification", "nftables chains check", "iptables fallback", "OpenWrt firewall", "basic rules validation"], "state": 2, "file_id": 9, "knowledge_revision": 51, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "d5d4f9158a3faa335968f7b500628028", "format-version": 4, "code-base-name": "cram_sample-2630", "filename": "sample_case/14-firewall-basic-rules.t", "revision_history": [{"51": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}