{"is_source_file": true, "format": "shell script", "description": "This file contains shell script commands and comments used for testing UCI (Unified Configuration Interface) configurations in a network device. It includes setup commands, verification steps, and comments explaining the purpose and setup prerequisites for validating UCI set/commit/reload cycles, particularly for wireless and network configurations.", "external_files": ["/etc/init.d/network"], "external_methods": ["uci set", "uci commit", "uci show"], "published": [], "classes": [], "methods": [], "calls": ["uci set wireless.@wifi-iface[0].isolation='0'", "uci commit wireless", "/etc/init.d/network reload", "uci show wireless", "grep -E 'isolation='", "sed 's/@[0-9]\\+/@N/g'", "sort", "uniq", "uci -q set network.globals='globals'", "uci set network.globals.ula_prefix='fd00:dead:beef::/48'", "uci commit network", "uci show network.globals", "sed 's/[0-9a-f]\\{4\\}:[0-9a-f]\\{4\\}:[0-9a-f]\\{4\\}/FD00:DEAD:BEEF/g'", "tr '[:lower:]' '[:upper:]'"], "search-terms": ["UCI", "network reload", "wireless", "uci set", "uci commit", "validation", "configuration test", "wireless.@wifi-iface", "network.globals", "reload"], "state": 2, "file_id": 6, "knowledge_revision": 47, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "513a4c021dde73ba092ba2f8ba283958", "format-version": 4, "code-base-name": "cram_sample-2630", "filename": "sample_case/16-uci-set-commit-reload.t", "revision_history": [{"47": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}