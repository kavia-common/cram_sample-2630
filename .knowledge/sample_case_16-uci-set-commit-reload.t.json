{"is_source_file": true, "format": "shell script", "description": "This file contains test scripts designed to validate UCI (Unified Configuration Interface) set, commit, and reload cycles for wireless and network configurations on a device under test (DUT). It includes commands to modify configurations, verify values, and ensure side-effect free reverts.", "external_files": ["/etc/init.d/network"], "external_methods": ["uci set", "uci commit", "uci show", "/etc/init.d/network reload"], "published": [], "classes": [], "methods": [], "calls": ["uci set wireless.@wifi-iface[0].isolation='0'", "uci commit wireless", "/etc/init.d/network reload", "uci show wireless", "grep -E 'isolation='", "sed 's/@[0-9]\\+/@N/g'", "sort", "uniq", "uci -q set network.globals='globals'", "uci set network.globals.ula_prefix='fd00:dead:beef::/48'", "uci commit network", "sed 's/[0-9a-f]\\{4\\}:[0-9a-f]\\{4\\}:[0-9a-f]\\{4\\}/FD00:DEAD:BEEF/g'", "tr '[:lower:]' '[:upper:]'"], "search-terms": ["uci set wireless", "reload network", "wireless.@wifi-iface", "network.globals", "ula_prefix", "uci commit", "UCI verification", "network reload", "wireless isolation", "sysctl", "rp_filter"], "state": 2, "file_id": 16, "knowledge_revision": 60, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "513a4c021dde73ba092ba2f8ba283958", "format-version": 4, "code-base-name": "cram_sample-2630", "filename": "sample_case/16-uci-set-commit-reload.t", "revision_history": [{"60": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}