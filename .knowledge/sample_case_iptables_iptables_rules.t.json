{"is_source_file": true, "format": "shell script", "description": "This file contains a shell script used for validating iptables availability, managing rules, checking counters, and verifying default policies on a QCA/OpenWrt device under test. It includes commands for detecting nftables, capturing snapshots, adding/removing rules, generating traffic, and verifying rule presence and counters.", "external_files": ["sample_cram/cram.sh"], "external_methods": ["command -v", "iptables", "nft", "sed", "grep", "sort", "tee", "head", "awk", "nc", "sleep"], "published": ["R"], "classes": [], "methods": [], "calls": ["command -v iptables", "iptables -S", "nft list ruleset", "iptables -L -n -v", "iptables -I INPUT 1 -p tcp --dport ${TEST_PORT} -j DROP", "iptables -D INPUT -p tcp --dport ${TEST_PORT} -j DROP", "nc -z -w1 127.0.0.1 ${TEST_PORT}"], "search-terms": ["iptables", "nftables", "OpenWrt", "QCA", "rule management", "counter verification", "default policies", "iptables snapshot", "traffic generation", "rule removal"], "state": 2, "file_id": 20, "knowledge_revision": 67, "git_revision": "9495d045931e6e1ff849c02c0fc1eb9baf5e33ac", "revision_history": [{"62": ""}, {"67": "9495d045931e6e1ff849c02c0fc1eb9baf5e33ac"}], "filename": "sample_case/iptables/iptables_rules.t", "format-version": 4, "code-base-name": "https://github.com/kavia-common/cram_sample-2630.git:cga-cm4dc6249a"}