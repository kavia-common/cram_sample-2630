{"is_source_file": true, "format": "shell script", "description": "This file is a shell script that adds an iptables LOG rule, verifies kernel log entries, and cleans up the rule, primarily used for testing iptables logging functionality.", "external_files": ["/sbin/iptables", "/bin/nc", "/usr/bin/logread", "/bin/dmesg", "/bin/grep", "/bin/tail", "/bin/sed"], "external_methods": ["iptables", "logread", "dmesg", "grep", "tail", "sed", "nc"], "published": [], "classes": [], "methods": [], "calls": ["iptables -I INPUT 1 -p tcp --dport 65531 -j LOG --log-prefix \"${LP} \" --log-level 4", "nc -z -w1 127.0.0.1 65531", "logread | grep -F \"${LP}\" | tail -n 1 | sed 's/[[:space:]]\\+/ /g'", "dmesg | grep -F \"${LP}\" | tail -n 1 | sed \"s/[[:space:]]\\+/ /g\"", "iptables -D INPUT -p tcp --dport 65531 -j LOG --log-prefix \"${LP} \" --log-level 4"], "search-terms": ["iptables log rule", "kernel log entries", "ip rules test", "iptables logging test", "shell script iptables"], "state": 2, "file_id": 2, "knowledge_revision": 48, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "1d54a33b9d8b8dec1baabd2bf25dd750", "format-version": 4, "code-base-name": "cram_sample-2630", "filename": "sample_case/23-iptables-logging.t", "revision_history": [{"48": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}