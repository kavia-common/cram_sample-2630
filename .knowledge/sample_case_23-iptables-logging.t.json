{"is_source_file": true, "format": "shell script", "description": "This file contains a shell script that tests iptables logging by adding a LOG rule, generating traffic, and verifying kernel log entries appear with a specific prefix.", "external_files": ["logread", "dmesg", "iptables", "nc"], "external_methods": ["logread", "dmesg", "iptables -I", "iptables -D", "nc"], "published": [], "classes": [], "methods": [], "calls": ["logread", "dmesg", "iptables -I INPUT 1 -p tcp --dport 65531 -j LOG --log-prefix \"${LP} \" --log-level 4", "nc -z -w1 127.0.0.1 65531", "iptables -D INPUT -p tcp --dport 65531 -j LOG --log-prefix \"${LP} \" --log-level 4"], "search-terms": ["iptables", "log_prefix", "kernel log", "iptables logging test", "iptables -I", "iptables -D", "logread", "dmesg", "packet testing"], "state": 2, "file_id": 27, "knowledge_revision": 114, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "1d54a33b9d8b8dec1baabd2bf25dd750", "format-version": 4, "code-base-name": "cram_sample-2630", "filename": "sample_case/23-iptables-logging.t", "revision_history": [{"114": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}